# Copy to .env (never commit .env). Real environment variables take precedence.
GROQ_API_KEY=
REVIEW_LLM_MODEL=openai/gpt-oss-20b
# Set to 1 to run without any API key (deterministic fake provider, used from Phase 3).
REVIEW_TEST_MODE=0
REVIEW_LLM_TIMEOUT_S=60
REVIEW_MAX_CONCURRENCY=3
REVIEW_MAX_RETRIES=2
REVIEW_MAX_REVISIONS=2
REVIEW_MAX_REPO_MB=50
REVIEW_MAX_FILES=10000
REVIEW_MAX_FILE_KB=512
REVIEW_TOOL_TIMEOUT_S=60
REVIEW_GIT_TIMEOUT_S=120
REVIEW_RUN_TIMEOUT_S=900
REVIEW_DATA_DIR=.reviewharness
REVIEW_LOG_LEVEL=INFO
